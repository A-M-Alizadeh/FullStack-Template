APP_ENV=local
APP_NAME=Digital Product Passport API
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dpp

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Optional: leave empty to disable Redis cache (NullCache).
REDIS_URL=redis://localhost:6379/0

# local | minio
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dpp
MINIO_SECURE=false

JWT_SECRET_KEY=local-dev-only-change-me-32chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=14

# Cross-origin frontend (:3000 → :8000): SameSite=none requires Secure.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
