APP_ENV=production
APP_NAME=Digital Product Passport API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1

# Prefer DATABASE_URL on managed hosts (Render/Railway). When set, it wins
# over the discrete POSTGRES_* fields below.
# DATABASE_URL=postgresql://user:pass@host:5432/dpp

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dpp

# Exact browser origin of the SPA (no trailing slash).
CORS_ORIGINS=["https://your-app.vercel.app"]
FRONTEND_URL=https://your-app.vercel.app
UPLOAD_DIR=uploads
SOFT_DELETE_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_API=120/minute
RUN_MIGRATIONS_ON_START=true
WEB_CONCURRENCY=2

# Leave empty unless you attach Redis. Local disk uploads are ephemeral on PaaS.
REDIS_URL=
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-minio-access
MINIO_SECRET_KEY=replace-minio-secret
MINIO_BUCKET=dpp
MINIO_SECURE=false

JWT_SECRET_KEY=replace-with-at-least-32-char-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_EXPIRE_DAYS=14

# Required for Vercel (HTTPS) → API on another host.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
