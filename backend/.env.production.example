APP_ENV=production
APP_NAME=Digital Product Passport API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dpp

CORS_ORIGINS=["https://your-domain.com"]
FRONTEND_URL=https://your-domain.com
UPLOAD_DIR=uploads
SOFT_DELETE_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_API=120/minute

REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-minio-access
MINIO_SECRET_KEY=replace-minio-secret
MINIO_BUCKET=dpp
MINIO_SECURE=false

JWT_SECRET_KEY=replace-with-at-least-32-char-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_EXPIRE_DAYS=14

COOKIE_SECURE=true
COOKIE_SAMESITE=none
