APP_ENV=production
APP_NAME=Digital Product Passport API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=dpp

CORS_ORIGINS=["https://your-domain.com"]
FRONTEND_URL=https://your-domain.com
UPLOAD_DIR=uploads

JWT_SECRET_KEY=replace-with-at-least-32-char-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_EXPIRE_DAYS=14
